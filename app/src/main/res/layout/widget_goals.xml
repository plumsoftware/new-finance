<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_goals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_goals_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:theme="@style/Theme.Finance.Widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_goals_title"
            android:textAllCaps="true"
            android:textColor="@color/widget_goals_title_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_goals_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_goals_total_placeholder"
            android:textColor="@color/widget_goals_total_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_goal_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_goal_emoji_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_goals_icon_bg"
            android:gravity="center"
            android:text="@string/widget_goal_emoji"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_goal_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_goal_placeholder_title"
                android:textColor="@color/widget_goals_text_primary"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/widget_goal_progress_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="32"
                android:progressDrawable="@drawable/widget_goals_progress_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_goal_percent_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_goal_placeholder_percent"
            android:textColor="@color/widget_goals_percent_blue"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/widget_goal_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_goals_divider" />

    <LinearLayout
        android:id="@+id/widget_goal_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_goal_emoji_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_goals_icon_bg"
            android:gravity="center"
            android:text="@string/widget_goal_emoji"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_goal_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_goal_placeholder_title"
                android:textColor="@color/widget_goals_text_primary"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/widget_goal_progress_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/widget_goals_progress_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_goal_percent_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_goal_placeholder_percent"
            android:textColor="@color/widget_goals_percent_green"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/widget_goal_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_goals_divider" />

    <LinearLayout
        android:id="@+id/widget_goal_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_goal_emoji_3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_goals_icon_bg"
            android:gravity="center"
            android:text="@string/widget_goal_emoji"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_goal_title_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_goal_placeholder_title"
                android:textColor="@color/widget_goals_text_primary"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/widget_goal_progress_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="15"
                android:progressDrawable="@drawable/widget_goals_progress_orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_goal_percent_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_goal_placeholder_percent"
            android:textColor="@color/widget_goals_percent_orange"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
