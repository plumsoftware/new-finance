<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_monthly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_monthly_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:theme="@style/Theme.Finance.Widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_monthly_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_monthly_title_default"
            android:textAllCaps="true"
            android:textColor="@color/widget_monthly_title_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_monthly_saved_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_monthly_badge_bg"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_monthly_saved_placeholder"
            android:textColor="@color/widget_monthly_badge_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_monthly_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_monthly_balance_placeholder"
        android:textColor="@color/widget_monthly_balance_text"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_monthly_dot_income" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/income"
                android:textColor="@color/widget_monthly_legend_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_monthly_dot_expense" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/expense"
                android:textColor="@color/widget_monthly_legend_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_monthly_divider"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/income"
                android:textColor="@color/widget_monthly_label_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_monthly_income_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_monthly_income_placeholder"
                android:textColor="@color/widget_monthly_income_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expense"
                android:textColor="@color/widget_monthly_label_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_monthly_expense_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_monthly_expense_placeholder"
                android:textColor="@color/widget_monthly_expense_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_monthly_operations"
                android:textColor="@color/widget_monthly_label_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_monthly_ops_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_monthly_ops_placeholder"
                android:textColor="@color/widget_monthly_balance_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
