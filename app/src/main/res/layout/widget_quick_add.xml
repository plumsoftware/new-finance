<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_add_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:theme="@style/Theme.Finance.Widget">

    <LinearLayout
        android:id="@+id/widget_add_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_quick_add_icon_bg"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="@color/widget_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_quick_add_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="@string/widget_quick_add_subtitle"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_products"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_quick_add_chip_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_category_products"
            android:textColor="@color/widget_chip_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chip_cafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_quick_add_chip_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_category_cafe"
            android:textColor="@color/widget_chip_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_chip_transport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_quick_add_chip_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingVertical="4dp"
        android:text="@string/widget_category_transport"
        android:textColor="@color/widget_chip_text"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
